DJANGO_SETTINGS_MODULE=Business_management_backend.settings_production
SECRET_KEY=replace-me
DEBUG=False
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
DB_NAME=smartbiz
DB_USER=smartbiz
DB_PASSWORD=replace-me
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=smartbiz
POSTGRES_USER=smartbiz
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_BUCKET=smartbiz-private
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
LOG_LEVEL=INFO
