# Copy to .env.staging at the repository root. Never copy production credentials.
# Replace all examples before use. This file does not start services.
DJANGO_SETTINGS_MODULE=Business_management_backend.settings_production
SECRET_KEY=replace-with-unique-staging-secret-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=api.staging.example.com
FRONTEND_URL=https://app.staging.example.com
CSRF_TRUSTED_ORIGINS=https://app.staging.example.com
CORS_ALLOWED_ORIGINS=https://app.staging.example.com
SECURE_SSL_REDIRECT=True
# Begin with a short staging HSTS lifetime; keep HTTPS mandatory.
SECURE_HSTS_SECONDS=300
DB_NAME=smartbiz_staging
DB_USER=smartbiz_staging
DB_PASSWORD=replace-with-unique-staging-database-password
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_BUCKET=replace-with-private-staging-only-bucket
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=replace-with-staging-storage-key
OBJECT_STORAGE_SECRET_KEY=replace-with-staging-storage-secret
EMAIL_HOST=replace-with-test-mail-service
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-staging-mail-user
EMAIL_HOST_PASSWORD=replace-with-staging-mail-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=staging@example.com
LOG_LEVEL=INFO
ATTACHMENT_SCANNER=documents.scanning.clamav
ATTACHMENT_SCAN_REQUIRED=True
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Supply a supported official image, preferably pinned to a reviewed digest.
CLAMAV_IMAGE=replace-with-reviewed-official-clamav-image
BACKUP_DIRECTORY=/backups
BACKUP_ENCRYPTION_KEY=replace-with-unique-staging-backup-key
# Enable only after the restore exercise and off-host encrypted retention are verified.
BACKUP_AUTOMATION_ENABLED=False
# Keep deletion disabled until isolated purge + backup-restore drills pass.
WORKSPACE_PURGE_ENABLED=False
WORKSPACE_PURGE_BACKUP_RETENTION_DAYS=0
# Existing, protected durable directory outside media and backup archives.
WORKSPACE_PURGE_LEDGER_DIR=
# Set actual proxy CIDRs after choosing the host; do not trust all networks.
TRUSTED_PROXY_NETWORKS=
# Configure only when testing passkeys on the chosen real staging domain.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
